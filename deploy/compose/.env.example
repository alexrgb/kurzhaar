# Copy to .env and edit. .env is git-ignored. Values below are development
# defaults, NOT secrets: change every password before exposing anything.

# Which services to start (comma separated profiles).
#   minimal                              -> 1 ClickHouse + Postgres + Redis
#   full,queue-redis | queue-kafka | queue-rabbitmq
COMPOSE_PROFILES=minimal

# Interface the published ports bind to. 127.0.0.1 = this machine only.
BIND_ADDRESS=127.0.0.1

# Image versions
CLICKHOUSE_VERSION=25.8
POSTGRES_VERSION=17
REDIS_VERSION=7
KAFKA_VERSION=3.9.1
RABBITMQ_VERSION=4

# Postgres
POSTGRES_USER=kurzhaar
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=kurzhaar
POSTGRES_PORT=5432

# ClickHouse (same user for all servers)
CLICKHOUSE_USER=kurzhaar
CLICKHOUSE_PASSWORD=change-me-clickhouse
# minimal: single server
CH_HTTP_PORT=8123
CH_NATIVE_PORT=9000
# full: RAW uses CH_RAW_*, API CH_API_*, dashboard CH_DASHBOARD_*
CH_RAW_HTTP_PORT=8123
CH_RAW_NATIVE_PORT=9000
CH_API_HTTP_PORT=8124
CH_API_NATIVE_PORT=9001
CH_DASHBOARD_HTTP_PORT=8125
CH_DASHBOARD_NATIVE_PORT=9002

# Queue: Redis
REDIS_PASSWORD=change-me-redis
REDIS_MAXMEMORY=512mb
REDIS_PORT=6379

# Queue: Kafka (host listener port; containers use kafka:9092)
KAFKA_PORT=9094
KAFKA_HEAP_OPTS=-Xms256m -Xmx512m

# Queue: RabbitMQ
RABBITMQ_USER=kurzhaar
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
